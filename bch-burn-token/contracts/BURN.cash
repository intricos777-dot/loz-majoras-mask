pragma cashscript ^0.13.0;

contract BurnMint() {
    function mint() {
        bool burned = false;
        for (int i = 0; i < tx.outputs.length; i++) {
            if (tx.outputs[i].lockingBytecode.split(1)[0] == 0x6a) {
                burned = true;
            }
        }
        require(burned);

        require(
            tx.outputs[this.activeInputIndex].lockingBytecode ==
            tx.inputs[this.activeInputIndex].lockingBytecode
        );
    }
}
